// aacode 多提供商配置示例。
//
// 放到 `$AACODE_CONFIG`，或 `{config_dir}/aacode/providers.jsonc`
// （Linux 一般是 `~/.config/aacode/providers.jsonc`）。
//
// 规则：
// - 一个 key = 一个端点，想连几个就写几个；
// - 密钥不写在这里：`auth.env` 是变量名列表，按顺序取第一个有值的；
//   省略 `env` 时按 id 推导，例如 `minekuai` → `MINEKUAI_API_KEY`；
// - `{env:VAR}` / `{file:path}` 在解析前替换（`~` 展开，相对路径相对本文件）；
// - `models` 是模型事实表；未声明的模型也能用，只是拿默认事实。

{
  "providers": {
    // 第三方 OpenAI 兼容网关：自定义 header 鉴权。
    "minekuai": {
      "base_url": "https://minekuai.cn/v1",
      "auth": { "kind": "header", "name": "x-api-key", "env": ["MINEKUAI_API_KEY"] },
      "headers": { "X-Title": "aacode" },
      "models": {
        // 模型名先用 `aa-agent-cli models minekuai` 列出来，再按需补事实。
        "some-model": {
          "context_window": 128000,
          "max_output_tokens": 8192,
          "supports_tools": true,
          "supports_images": false
        }
      }
    },

    // 标准 Bearer 鉴权。
    "agnes": {
      "base_url": "https://apihub.agnes-ai.com/v1",
      "auth": { "kind": "bearer", "env": ["AGNES_API_KEY"] },
      "models": {
        "agnes-2.0-flash": {},
        "agnes-2.5-flash": { "supports_tools": true }
      }
    },

    // 本地端点：没有鉴权。
    "ollama": {
      "base_url": "http://localhost:11434/v1",
      "auth": { "kind": "none" }
    }
  }
}
