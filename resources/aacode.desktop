[Desktop Entry]
Version=1.0
Type=Application
Name=AACode
GenericName=Text Editor
Comment=A code editor built with Rust and GPUI
Exec=aacode %F
TryExec=aacode
Icon=aacode
Terminal=false
StartupNotify=true
Categories=Development;IDE;TextEditor;
Keywords=editor;code;ide;development;programming;rust;
MimeType=text/plain;text/x-makefile;text/x-c;text/x-c++hdr;text/x-c++src;text/x-chdr;text/x-csrc;text/x-diff;text/x-java;text/x-python;text/x-ruby;text/x-shellscript;text/x-sql;text/xml;application/json;application/toml;application/x-yaml;application/yaml;application/xml;

# 注意：不写 StartupWMClass。
# gpui 的 Platform::set_app_identity 是 default no-op（gpui/src/platform.rs:323），
# zed 官方在 Linux 侧也没调用它，因此 X11 的 WM_CLASS / Wayland 的 app_id 并不由这里
# 决定。写一个与运行时不匹配的值反而会让任务栏图标关联不上。
# 窗口标题目前由 packages/app/src/main.rs 的 WindowOptions.titlebar 设为 "aacode"；
# 数据目录仍取自 paths::APP_NAME（当前 "Zed"，待后续单独修改）。