// aacode 设置示例。
//
// 放到 `$AACODE_SETTINGS`，或 `{config_dir}/aacode/settings.jsonc`
// （Linux 一般是 `~/.config/aacode/settings.jsonc`）。
//
// 规则：
// - `language_model_providers.<section>`：一个 key = 一个端点，想连几个就写几个；
//   `openai_compatible.<id>` 走 `/chat/completions`（OpenAI 官方、第三方网关、vLLM）；
//   `ollama` 是原生 section（`/api/chat`，NDJSON）；
//   `llama.cpp` 是独立的本地 provider section（wire 仍是 OpenAI 兼容 `/v1`）；
//   `openrouter` 是 OpenRouter 专用 section（同形协议 + 思考回放 / 归因 header）；
// - 密钥不写在这里：`auth.env` 是变量名列表，按顺序取第一个有值的；
//   省略 `env` 时按 id 推导，例如 `minekuai` → `MINEKUAI_API_KEY`；
// - `{env:VAR}` / `{file:path}` 在解析前替换（`~` 展开，相对路径相对本文件）；
// - `context_window` 是上下文窗口（不是输出上限），`max_output_tokens` 才是输出上限；
// - `available_models` 里没声明的模型也能用，只是拿默认事实；
// - 本文件会深合并到内置的 `assets/settings/default.jsonc` 上：
//   没写的字段保留默认值，写 `null` 也等于「没写」（不覆盖默认）。
// - `proxy` 是顶层设置（Zed 同名）：`http://` / `https://` 代理，空串 = 读环境变量；
//   `NO_PROXY` 的直连列表始终生效。请求走系统信任库，代理自己的 CA 装在系统里即可。

{
  // 本机 mitmproxy（mitmweb）监听 8080。改成 http:// 也行 —— `https://` 表示
  // 先用 TLS 连代理本身（mitmproxy 支持，但它的 CA 必须在系统信任库里）。
  "proxy": "https://127.0.0.1:8080",
  "language_model_providers": {
    "openai_compatible": {
      // 第三方 OpenAI 兼容网关。鉴权用 Bearer：该网关的 /v1/chat/completions
      // 只认 `Authorization: Bearer`；`x-api-key` 只在 /v1/models 上被接受
      // （实测同一个 key：models 200，chat 401 invalid_request_error）。
      "minekuai": {
        "base_url": "https://ai-api.minekuai.cn/v1",
        "auth": {
          "kind": "bearer",
          "env": ["MINEKUAI_API_KEY"],
        },
        "headers": { "X-Title": "aacode" },
        "available_models": [
          {
            "name": "deepseek-v4.1-flash-1017",
            "display_name": "DeepSeek V4.1 Flash",
            "context_window": 256000,
            "max_output_tokens": 32000,
            "reasoning_effort": "medium",
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": true,
              "prompt_cache_key": true,
              "chat_completions": true,
              "interleaved_reasoning": true,
              // true = 发 `max_tokens`；false（默认）= 发 `max_completion_tokens`。
              // 第三方网关多数只认 `max_tokens`，所以这里显式打开。
              "max_tokens_parameter": true,
            },
          },
        ],
      },

      // 标准 Bearer 鉴权。
      "agnes": {
        "base_url": "https://apihub.agnes-ai.com/v1",
        "auth": { "kind": "bearer", "env": ["AGNES_API_KEY"] },
        "available_models": [
          {
            "name": "agnes-3.0-flash",
            "display_name": "Agnes 3.0 Flash",
            "context_window": 512000,
            "max_output_tokens": 65536,
            "reasoning_effort": "medium",
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": true,
              "prompt_cache_key": true,
              "chat_completions": true,
              "interleaved_reasoning": true,
              "max_tokens_parameter": true,
            },
          },
        ],
      },
    },
    // 本地 llama.cpp：独立 provider section（wire 仍是 OpenAI 兼容 `/v1`）。
    // 端口按 `llama-server --port` 的实际值填（Zed 默认 8080）；base_url 必须带 /v1。
    "llama.cpp": {
      "base_url": "http://localhost:8080/v1",
      "auth": { "kind": "none" },
    },
    // 本地 Ollama：独立 provider section，原生 `/api/chat`（NDJSON）。
    // 测本地模型挑最小的（先 `ollama pull` 一次）：qwen2.5:0.5b / llama3.2:1b；
    // 名字带 `:cloud` 的模型现在要付费，不算本地。
    // 想走 OpenAI 兼容的 `/v1`，写 `openai_compatible.ollama` 即可（同名时兼容
    // 条目优先），不需要额外的 section。
    "ollama": {
      "base_url": "http://localhost:11434",
      "auth": { "kind": "none" },
    },

    // OpenRouter：官方端点 + 免费模型（`aacode models openrouter --free`）。
    // 协议与 OpenAI chat completions 同形，但由独立的 `aa_ai_openrouter` 处理：
    // 思考回放（`reasoning` / `reasoning_details`）、数字错误码、模型目录里的
    // `pricing`。密钥从 `OPENROUTER_API_KEY` 读（也可以写进 .env）。
    // `app_url` / `app_title` 是 OpenRouter 的排行榜归因 header
    // （`HTTP-Referer` / `X-Title`），可选。
    // 注意：具体 `:free` 模型用的是上游共享池，很容易 429
    // （`metadata.raw` 会写 `upstream_provider_shared_pool`）；`openrouter/free`
    // 是动态路由，会挑一个当前可用的免费模型，更适合日常试跑。
    "openrouter": {
      "base_url": "https://openrouter.ai/api/v1",
      "auth": { "kind": "bearer", "env": ["OPENROUTER_API_KEY"] },
      "app_url": "https://github.com/aa/aacode",
      "app_title": "aacode",
      // 免费模型不用全写；`models openrouter --free` 看目录，声明的条目只是
      // 「带上准确的模型事实」。未声明的模型（例如 `openrouter/free`）也能用默认事实。
      "available_models": [
        {
          "name": "google/gemma-4-31b-it:free",
          "context_window": 262144,
          "capabilities": { "tools": true },
        },
      ],
    },
  },
}
