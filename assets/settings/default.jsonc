// aacode 内置默认设置。
//
// 用户的 settings.jsonc 会深合并到这里：
// - 用户没写的字段保留这里的值；
// - 用户写 null 也视为「没写」（不覆盖默认）；
// - 数组（如 available_models）整体覆盖，不做逐项合并。
//
// 只放不需要密钥、可以无条件存在的端点（本地服务）。

{
  // 出站代理（对齐 Zed 的顶层 `proxy` 设置）：空串 = 不显式设置，
  // HTTP 客户端自己读 ALL_PROXY / HTTPS_PROXY / HTTP_PROXY；NO_PROXY 的直连列表始终生效。
  "proxy": "",
  "language_model_providers": {
    "deepseek": {
      "base_url": "https://api.deepseek.com/v1",
    },
    "open_router": {
      "base_url": "https://openrouter.ai/api/v1",
    },
    "openai_compatible": {},
    // llama.cpp 没有单独 section：llama-server 的 /v1 就是 OpenAI 兼容形状，
    // 归 openai_compatible.<id>（示例见 settings.example.jsonc）。
    "ollama": {
      // 根地址（Zed 形状）。原生 /api/chat 适配器尚未实现，现在只解析不生效；
      // 要用本地 Ollama 请配 openai_compatible.ollama（OpenAI 兼容 /v1）。
      "base_url": "http://localhost:11434",
    },
  },
}
