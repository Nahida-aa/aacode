// aacode 内置默认设置。
//
// 用户的 settings.jsonc 会深合并到这里：
// - 用户没写的字段保留这里的值；
// - 用户写 null 也视为「没写」（不覆盖默认）；
// - 数组（如 available_models）整体覆盖，不做逐项合并。
//
// 只放「不需要在配置里写密钥」的端点：密钥仍然从环境变量读
// （例如 openrouter 默认找 OPENROUTER_API_KEY），所以默认层可以无条件存在。

{
  // 出站代理（对齐 Zed 的顶层 `proxy` 设置）：空串 = 不显式设置，
  // HTTP 客户端自己读 ALL_PROXY / HTTPS_PROXY / HTTP_PROXY；NO_PROXY 的直连列表始终生效。
  "proxy": "",
  "language_model_providers": {
    "deepseek": {
      "base_url": "https://api.deepseek.com/v1",
    },
    "openrouter": {
      // 协议与 OpenAI chat completions 同形，但思考回放（`reasoning_details`）、
      // 数字错误码、归因 header 不同，由独立的 `aa_ai_openrouter` 处理。
      // 密钥默认读 OPENROUTER_API_KEY；`app_url` / `app_title` 对应
      // `HTTP-Referer` / `X-Title`（可选）。
      "base_url": "https://openrouter.ai/api/v1",
    },
    "openai_compatible": {},
    // llama.cpp 没有单独 section：llama-server 的 /v1 就是 OpenAI 兼容形状，
    // 归 openai_compatible.<id>（示例见 settings.example.jsonc）。
    "ollama": {
      // 根地址（Zed 形状）。原生 /api/chat：NDJSON、`thinking` 字段。
      // 同一台服务器的 OpenAI 兼容视图另配 openai_compatible.ollama（`/v1`），
      // 同名时 compatible 条目覆盖本 section。
      "base_url": "http://localhost:11434",
    },
  },
}
