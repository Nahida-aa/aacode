// aacode 内置默认设置。
//
// 用户的 settings.jsonc 会深合并到这里：
// - 用户没写的字段保留这里的值；
// - 用户写 null 也视为「没写」（不覆盖默认）；
// - 数组（如 available_models）整体覆盖，不做逐项合并。
//
// 只放不需要密钥、可以无条件存在的端点（本地服务）。

{
  "language_models": {
    "deepseek": {
      "api_url": "https://api.deepseek.com/v1",
    },
    "open_router": {
      "api_url": "https://openrouter.ai/api/v1",
    },
    "openai_compatible": {},
    "ollama": {
      // 根地址（Zed 形状）。语义上是原生 /api/chat；库层还没有原生适配器，
      // 当前过渡实现会补成 OpenAI 兼容的 /v1。
      "api_url": "http://localhost:11434",
    },
  },
}
