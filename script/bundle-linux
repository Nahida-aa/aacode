#!/usr/bin/env bash
#
# 构建 Linux 发布 tarball。对齐 Zed `script/bundle-linux`，逐段保持同构：
#   读 channel / 版本 → 交叉编译（gnu + musl）→ sentry 上传（可选）
#   → objcopy 拆 .dbg 并 strip → 收集动态库到 lib/ → 图标 + .desktop → tar.gz
#
# 与 Zed 的差异（均为有意为之，改动前先读这里）：
#
# 1. crate / 路径改名
#    zed → aacode，crates/zed/resources/ → packages/app/resources/。
#    注意**没有** crates/zed/RELEASE_CHANNEL → packages/app/RELEASE_CHANNEL 的对应，
#    因为 aacode 已删除那个文件（见下面第 4 条）。
#
# 2. 图标分 channel（与 Zed 一致）
#    按 $suffix 取 app-icon$suffix.png —— stable 无后缀，其余带 -<channel>。
#    $suffix 由下方的 channel 变量算出，与 Zed `crates/zed/build.rs` 的 icon_path()
#    （L221-240）同一套规则；`just icons` 从 assets/images/aacode{,-dev,-nightly,
#    -preview}.svg 生成这 8 个文件（4 channel × 512/1024）。
#    差异：Zed 在 build.rs 里用 `option_env!("RELEASE_CHANNEL")` 决定后缀，
#    aacode 同样在 build.rs 里用 `option_env!("ZED_RELEASE_CHANNEL")`；脚本侧的
#    $channel 只是**同一个 env 的副本**，用于算 tarball 名和拷图标，取值同源。
#
# 3. libexec 里的名字
#    Zed: release/zed → libexec/zed-editor、release/cli → bin/zed。
#    aacode: release/aacode → libexec/aacode、release/cli → bin/aacode。
#    注意 bin/ 放的是 **cli 二进制**（与 Zed 一致）—— install.sh / 用户 PATH 里的
#    `aacode` 命中的是它，而 desktop 的 Exec 也走它，这正是 [Desktop Action
#    NewWorkspace] 里 `aacode --new` 能工作的原因。主应用在 libexec/ 里，
#    zed 的 install.sh（main.rs 的 open_listener::listen_for_cli_connections）经
#    zed-cli:// socket 把请求转给它。
#
# 4. sentry
#    换成 -p aacode / -o aacode-dev；未设 SENTRY_AUTH_TOKEN 时整段自动跳过
#    （与 Zed 同逻辑，Zed 那段 L92-113）。
#
# 5. blob-store
#    仍然 source script/lib/blob-store.sh（原样取自 Zed），但本脚本不调用上传函数 ——
#    上传由发布流程单独触发，与 Zed 的分工相同。
#
# 依赖的辅助文件（本次一并从 Zed 移植/适配）：
#   script/get-crate-version          原样
#   script/lib/blob-store.sh          原样
#   script/generate-licenses          适配：icons 的 LICENSES 读 gpui_learn 那边
#                                     （aacode 的图标是 aa_icons crate），
#                                     配置改名 aacode-licenses.toml
#   script/licenses/template.md.hbs   原样
#   script/licenses/aacode-licenses.toml  从 zed-licenses.toml 改注释措辞
#   .cargo/bundle-config.toml         原样（rpath=$ORIGIN/../lib 供 lib/ 收集的动态库）
#
# 产物：target/release/aacode-linux-<arch>.tar.gz
#       内含 aacode[.<channel>].app/{bin,libexec,lib,share}/
#       target/release/aacode-remote-server-linux-<arch>.gz（单独文件）

set -euxo pipefail
source script/lib/blob-store.sh

# Function for displaying help info
help_info() {
  echo "
Usage: ${0##*/} [options]
Build a release .tar.gz for Linux.

Options:
  -h, --help     Display this help and exit.
  --flatpak      Set ZED_BUNDLE_TYPE=flatpak so that this can be included in system info
  "
}

# Parse all arguments manually
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            help_info
            exit 0
            ;;
        --flatpak)
            export ZED_BUNDLE_TYPE=flatpak
            shift
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "Unknown option: $1" >&2
            help_info
            exit 1
            ;;
        *)
            echo "Error: Unexpected argument: $1" >&2
            help_info
            exit 1
            ;;
    esac
done

if [[ -n "${RUSTFLAGS+x}" || -n "${CARGO_ENCODED_RUSTFLAGS+x}" ]]; then
    echo "Unset RUSTFLAGS and CARGO_ENCODED_RUSTFLAGS; put extra flags in target rustflags in .cargo/config.toml so bundle flags are preserved." >&2
    exit 1
fi

export ZED_BUNDLE=true

# 【有意偏离 Zed】Zed 在这里是 `channel=$(<crates/zed/RELEASE_CHANNEL)`，从仓库里
# 那个文件读 —— 因为它的 CI 靠改写文件来切频道（bump_zed_version.yml /
# release_nightly.yml 里 `echo -n preview > crates/zed/RELEASE_CHANNEL` 后连同 tag
# 一起提交）。
#
# aacode 已删除该文件，改为「设置环境变量，否则 dev」
# （packages/release_channel/src/lib.rs 的 compile_time_release_channel_name 用
# option_env! 读构建期值）。所以这里必须**显式 export** ZED_RELEASE_CHANNEL：
#   - 不 export 的话，lib.rs 与 app/build.rs 都会兜底成 dev，
#     而脚本自己算 suffix 用的是本行的 $channel → 会出现
#     「tarball 名叫 aacode-nightly.app、里面的二进制却是 dev」的不一致；
#   - 发布 tarball 不该是 dev，故默认值取 stable（可用环境变量覆盖，
#     如 RELEASE_CHANNEL=nightly ./script/bundle-linux）。
channel="${RELEASE_CHANNEL:-stable}"
export ZED_RELEASE_CHANNEL="${channel}"

target_dir="${CARGO_TARGET_DIR:-target}"

version="$(script/get-crate-version aacode)"
# Set RELEASE_VERSION so it's compiled into GPUI and it knows about the version.
export RELEASE_VERSION="${version}"

commit=$(git rev-parse HEAD | cut -c 1-7)

version_info=$(rustc --version --verbose)
host_line=$(echo "$version_info" | grep host)
target_triple=${host_line#*: }
musl_triple=${target_triple%-gnu}-musl
remote_server_triple=${REMOTE_SERVER_TARGET:-"${musl_triple}"}
rustup_installed=false
if command -v rustup >/dev/null 2>&1; then
    rustup_installed=true
fi

# Generate the licenses first, so they can be baked into the binaries
script/generate-licenses

if "$rustup_installed"; then
    rustup target add "$remote_server_triple"
fi

export CC=${CC:-$(which clang)}

# Build binary in release mode
# LK_CUSTOM_WEBRTC 同 just install 里的理由：webrtc-sys（git rev 0a1c519）的
# download_webrtc() 无缓存判断（开头就 remove_dir_all + 无条件下载），且 prebuilt_dir()
# 落在 OUT_DIR 下 —— 换 --target 或改 profile 都会让 OUT_DIR 变 → 重新下载 575 MB。
# musl 交叉编译那次的 OUT_DIR 与宿主不同，也用同一份缓存（libwebrtc.a 是静态库，
# 与 target 无关）。
export LK_CUSTOM_WEBRTC="${LK_CUSTOM_WEBRTC:-$HOME/.cache/aacode/webrtc/webrtc-0001d84-4-linux-x64-release}"

cargo --config .cargo/bundle-config.toml build --release --target "${target_triple}" --package aacode --package cli
# Build remote_server in separate invocation to prevent feature unification from other crates
# from influencing dynamic libraries required by it.
if [[ "$remote_server_triple" == "$musl_triple" ]]; then
    musl_cc_var="CC_$(echo "$remote_server_triple" | tr '-' '_')"
    export "$musl_cc_var"=musl-gcc
fi
cargo --config .cargo/bundle-config.toml build --release --target "${remote_server_triple}" --package remote_server

# Upload debug info to sentry.io
if ! command -v sentry-cli >/dev/null 2>&1; then
    echo "sentry-cli not found. skipping sentry upload."
    echo "install with: 'curl -sL https://sentry.io/get-cli | bash'"
else
    if [[ -n "${SENTRY_AUTH_TOKEN:-}" ]]; then
        echo "Uploading aacode debug symbols to sentry..."
        # note: this uploads the unstripped binary which is needed because it contains
        # .eh_frame data for stack unwinding. see https://github.com/getsentry/symbolic/issues/783
        for attempt in 1 2 3; do
            echo "Attempting sentry upload (attempt $attempt/3)..."
            if sentry-cli debug-files upload --include-sources --wait -p aacode -o aacode-dev \
                "${target_dir}/${target_triple}"/release/aacode \
                "${target_dir}/${remote_server_triple}"/release/remote_server; then
                echo "Sentry upload successful on attempt $attempt"
                break
            else
                echo "Sentry upload failed on attempt $attempt"
                if [ $attempt -eq 3 ]; then
                    echo "All sentry upload attempts failed"
                fi
            fi
        done
    else
        echo "missing SENTRY_AUTH_TOKEN. skipping sentry upload."
    fi
fi

# Split debug symbols into local .dbg files, then strip debug info and local
# symbols from the shipped binaries. Sentry receives the full unstripped
# binaries above; the .dbg files keep symbols recoverable when that upload
# is skipped.
# We use llvm-objcopy because GNU objcopy on older distros (e.g. Ubuntu 20.04)
# doesn't understand CREL sections produced by newer LLVM.
llvm-objcopy --only-keep-debug "${target_dir}/${target_triple}/release/aacode" "${target_dir}/${target_triple}/release/aacode.dbg"
llvm-objcopy --only-keep-debug "${target_dir}/${remote_server_triple}/release/remote_server" "${target_dir}/${remote_server_triple}/release/remote_server.dbg"
llvm-objcopy --strip-debug --discard-all "${target_dir}/${target_triple}/release/aacode"
llvm-objcopy --strip-debug --discard-all "${target_dir}/${target_triple}/release/cli"
llvm-objcopy --strip-debug --discard-all "${target_dir}/${remote_server_triple}/release/remote_server"

# Ensure that remote_server does not depend on libssl nor libcrypto, as we got rid of these deps.
if ldd "${target_dir}/${remote_server_triple}/release/remote_server" | grep -q 'libcrypto\|libssl'; then
    if [[ "$remote_server_triple" == *-musl ]]; then
        echo "Error: remote_server still depends on libssl or libcrypto" && exit 1
    else
        echo "Info: Using non-musl remote-server build."
    fi
fi

suffix=""
if [ "$channel" != "stable" ]; then
  suffix="-$channel"
fi

# Move everything that should end up in the final package
# into a temp directory.
temp_dir=$(mktemp -d)
zed_dir="${temp_dir}/aacode$suffix.app"

# Binary
mkdir -p "${zed_dir}/bin" "${zed_dir}/libexec"
cp "${target_dir}/${target_triple}/release/aacode" "${zed_dir}/libexec/aacode"
cp "${target_dir}/${target_triple}/release/cli" "${zed_dir}/bin/aacode"

# Libs
# Bundle libstdc++ so older supported systems can run binaries built with our
# toolchain even when their system libstdc++.so.6 lacks required GLIBCXX symbols.
#
# Never bundle the GLib family or its private dependencies: host libraries that
# get dlopen'd are built against the system GLib, and resolving them against an
# older bundled copy fails with missing symbols.
find_libs() {
    ldd ${target_dir}/${target_triple}/release/aacode |\
        cut -d' ' -f3 |\
        grep -v '\<\(libc.so\|libgcc_s.so\|libm.so\|libpthread.so\|libdl.so\|libasound.so\)' |\
        grep -v '\<\(libglib-2.0.so\|libgobject-2.0.so\|libgio-2.0.so\|libgmodule-2.0.so\|libpcre.so\|libpcre2-8.so\|libmount.so\|libblkid.so\|libselinux.so\|libffi.so\|libresolv.so\|libz.so\)'
}

mkdir -p "${zed_dir}/lib"
rm -rf "${zed_dir}/lib/*"
cp $(find_libs) "${zed_dir}/lib"

# Icons
mkdir -p "${zed_dir}/share/icons/hicolor/512x512/apps"
cp "packages/app/resources/app-icon$suffix.png" "${zed_dir}/share/icons/hicolor/512x512/apps/aacode.png"
mkdir -p "${zed_dir}/share/icons/hicolor/1024x1024/apps"
cp "packages/app/resources/app-icon$suffix@2x.png" "${zed_dir}/share/icons/hicolor/1024x1024/apps/aacode.png"

# .desktop
export DO_STARTUP_NOTIFY="true"
export APP_CLI="aacode"
export APP_ICON="aacode"
export APP_ARGS="%U"
if [[ "$channel" == "preview" ]]; then
  export APP_NAME="AACode Preview"
  APP_ID="dev.aacode.AACode-Preview"
elif [[ "$channel" == "nightly" ]]; then
  export APP_NAME="AACode Nightly"
  APP_ID="dev.aacode.AACode-Nightly"
elif [[ "$channel" == "dev" ]]; then
  export APP_NAME="AACode Dev"
  APP_ID="dev.aacode.AACode-Dev"
else
  export APP_NAME="AACode"
  APP_ID="dev.aacode.AACode"
fi

mkdir -p "${zed_dir}/share/applications"
envsubst < "packages/app/resources/aacode.desktop.in" > "${zed_dir}/share/applications/$APP_ID.desktop"
chmod +x "${zed_dir}/share/applications/$APP_ID.desktop"

# Copy generated licenses so they'll end up in archive too
cp "assets/licenses.md" "${zed_dir}/licenses.md"

# Create archive out of everything that's in the temp directory
arch=$(uname -m)
archive="aacode-linux-${arch}.tar.gz"

rm -rf "${archive}"
remove_match="aacode(-[a-zA-Z0-9]+)?-linux-$(uname -m)\.tar\.gz"
ls "${target_dir}/release" | grep -E ${remove_match} | xargs -d "\n" -I {} rm -f "${target_dir}/release/{}" || true
tar -czvf "${target_dir}/release/$archive" -C ${temp_dir} "aacode$suffix.app"

gzip -f --stdout --best "${target_dir}/${remote_server_triple}/release/remote_server" > "${target_dir}/aacode-remote-server-linux-${arch}.gz"
