{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", ".vercel/**"],
      "env": [
        "VITE_APP_URL",
        "BETTER_AUTH_SECRET",
        "DATABASE_URL",
        "ELECTRIC_URL",
        "ELECTRIC_SOURCE_ID",
        "ELECTRIC_SECRET",
        "VITE_S3_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
